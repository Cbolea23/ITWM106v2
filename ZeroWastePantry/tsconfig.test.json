{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "outDir": "dist-test",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/types/**/*.ts",
    "src/constants/**/*.ts",
    "src/utils/**/*.ts",
    "src/database/**/*.ts",
    "tests/**/*.ts"
  ]
}
